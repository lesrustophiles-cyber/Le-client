onClipEvent(load){
   function __f_construct(eventObj)
   {
      autoLoad = true;
      centerContent = false;
      contentPath = "";
      enabled = true;
      forceReload = false;
      scaleContent = true;
      styleName = "default";
      instanceNumber = 3;
   }
   this.addEventListener("construct",__f_construct);
}
