onClipEvent(load){
   function __f_construct(eventObj)
   {
      cellRenderer = "ItemViewerItem";
      enabled = false;
      multipleSelection = false;
      rowHeight = 20;
      styleName = "none";
      autoLoad = true;
      centerContent = false;
      contentPath = "";
      forceReload = false;
      scaleContent = false;
      border = false;
      html = true;
      selectable = false;
      styleSheet = "";
      displayWidth = 180;
      text = "";
      url = "";
      wordWrap = false;
      multiline = false;
      showBaseEffects = true;
   }
   this.addEventListener("construct",__f_construct);
}
